# FreeLLM Chat — server-side secrets only
# Copy to .env.local for local development

# Optional: custom SQLite path
# FREELLM_DB_PATH=./data/freellm.db

# Provider API keys (never expose to the browser)
AION_LABS_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GROQ_API_KEY=
KILO_API_KEY=
LLM7_API_KEY=
MODELSCOPE_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OVHCLOUD_API_KEY=
SILICONFLOW_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
OLLAMA_API_KEY=

# GitHub personal access token for conversation export
GITHUB_TOKEN=

# Optional OpenRouter attribution
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=FreeLLM Chat
