# FreeLLM Chat — server-side secrets only
# Copy to .env.local for local development

# Optional: custom SQLite path for ChatFRE conversation storage
# FREELLM_DB_PATH=./data/freellm.db

# FreeLLMAPI gateway (required for chat)
# Start FreeLLMAPI separately (see docker-compose.yml), then paste the
# unified key from its Keys page dashboard.
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=

# GitHub personal access token for conversation export
GITHUB_TOKEN=
