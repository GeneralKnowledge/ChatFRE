# =============================================================================
# Required
# =============================================================================

# Encrypts FreeLLMAPI provider keys at rest (keep stable across upgrades)
# Generate once: openssl rand -hex 32
ENCRYPTION_KEY=

# FreeLLMAPI unified key from http://127.0.0.1:3001 → Keys page header
FREELLMAPI_API_KEY=

# Day-1 tip: add 2–3 free provider keys in FreeLLMAPI (Groq + OpenRouter +
# Gemini or Cloudflare Workers AI) so `auto` failover feels reliable.

DEFAULT_MODELS=auto
OPEN_WEBUI_MEMORY_LIMIT=2g

# =============================================================================
# Cloudflare personal mode (recommended for you)
#   ./scripts/up-cloudflare.sh
# =============================================================================

# No login / no signup
WEBUI_AUTH=false
ENABLE_SIGNUP=false

# Open WebUI published for Cloudflare on port 8080
OPEN_WEBUI_PORT=8080
# 0.0.0.0 = reachable as Cloudflare origin; use 127.0.0.1 if using cloudflared tunnel only
OPEN_WEBUI_BIND=0.0.0.0

# =============================================================================
# Local / SSH-tunnel only (optional)
#   ./scripts/up.sh
# =============================================================================

# OPEN_WEBUI_PORT=3000
# OPEN_WEBUI_BIND=127.0.0.1

# =============================================================================
# Optional Caddy + login mode (not needed with Cloudflare)
#   ./scripts/up-server.sh
# =============================================================================

# DOMAIN=chat.example.com
# CADDY_EMAIL=you@example.com
# WEBUI_SECRET_KEY=
# ENABLE_SIGNUP=true
# WEBUI_AUTH=true
