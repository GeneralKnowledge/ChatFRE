# =============================================================================
# Required for all modes
# =============================================================================

# Encrypts FreeLLMAPI provider keys at rest (keep stable across upgrades)
# Generate once: openssl rand -hex 32
ENCRYPTION_KEY=

# FreeLLMAPI unified key from http://127.0.0.1:3001 → Keys page header
# After creating it: docker compose up -d open-webui
FREELLMAPI_API_KEY=

# =============================================================================
# Local / SSH-tunnel mode (default: docker compose up -d)
# =============================================================================

# WEBUI_AUTH=false
# OPEN_WEBUI_PORT=3000
# FREELLMAPI_PORT=3001

# =============================================================================
# Personal server mode
#   docker compose -f docker-compose.yml -f docker-compose.server.yml --profile server up -d
# =============================================================================

# Public hostname pointing at this server (A/AAAA record). Required for HTTPS.
DOMAIN=chat.example.com

# Optional Let's Encrypt contact email
CADDY_EMAIL=you@example.com

# Open WebUI session secret (required in server mode)
WEBUI_SECRET_KEY=

# First boot only: set true so you can create the admin account, then set false
# and recreate open-webui.
ENABLE_SIGNUP=true

# Canonical public URL (defaults to https://$DOMAIN in server override)
# WEBUI_URL=https://chat.example.com

# Optional: bind Caddy only on a specific interface
# CADDY_HTTP_BIND=0.0.0.0
# CADDY_HTTPS_BIND=0.0.0.0
