# Required: encrypts FreeLLMAPI provider keys at rest (keep stable across upgrades)
# Generate once: openssl rand -hex 32
ENCRYPTION_KEY=

# FreeLLMAPI unified key from http://127.0.0.1:3001 → Keys page header
# After you create it, paste here and recreate the open-webui service:
#   docker compose up -d open-webui
FREELLMAPI_API_KEY=

# Optional Open WebUI settings
# WEBUI_AUTH=false          # default: no login (personal use)
# WEBUI_SECRET_KEY=         # set if WEBUI_AUTH=true (openssl rand -hex 32)
# OPEN_WEBUI_PORT=3000
# FREELLMAPI_PORT=3001
# HOST_BIND=127.0.0.1       # use 0.0.0.0 only on a trusted LAN
